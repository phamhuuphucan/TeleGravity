# 1. Token nhận từ @BotFather trên Telegram (Bắt buộc)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhI_your_bot_token_here

# 2. Telegram User ID lấy từ @userinfobot (Bắt buộc). Nhiều ID cách nhau bằng dấu phẩy.
ALLOWED_USER_IDS=987654321

# 3. Đường dẫn Antigravity CLI (Để trống để tự động dò tìm trên macOS / Linux / Windows)
# Ví dụ macOS/Linux: ~/.local/bin/agy
# Ví dụ Windows: C:\Users\TenBan\.local\bin\agy.exe
AGY_PATH=

# 4. Thư mục làm việc mặc định và thư mục gốc chứa các dự án (/projects, /cd TenDuAn)
# Ví dụ macOS/Linux: ~/Projects
# Ví dụ Windows: C:\Users\TenBan\Projects
DEFAULT_WORKSPACE=~/Projects
PROJECTS_ROOT=~/Projects

# 5. Model mặc định (xem danh sách bằng lệnh /model trên Telegram). Để trống = mặc định của agy
DEFAULT_MODEL=

# 6. Chế độ duyệt quyền:
# - default      : Hỏi trước cả khi sửa file & khi chạy lệnh shell
# - accept-edits : Tự sửa file trong workspace, chỉ hỏi khi chạy lệnh shell (Khuyên dùng)
# - plan         : Lập kế hoạch trước khi thực thi
DEFAULT_MODE=accept-edits

# 7. Tự động duyệt mọi yêu cầu không cần hỏi (Khuyến nghị: false)
AUTO_APPROVE=false

# 8. Thời gian chờ bấm nút duyệt trên Telegram (giây), quá hạn sẽ tự động từ chối
APPROVAL_TIMEOUT_SECONDS=600
