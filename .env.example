# 1. Token nhận từ @BotFather trên Telegram (Bắt buộc)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhI_your_bot_token_here

# 2. Telegram User ID lấy từ @userinfobot (Bắt buộc). Nhiều ID cách nhau bằng dấu phẩy.
ALLOWED_USER_IDS=987654321

# 3. Đường dẫn Antigravity CLI (Để trống để tự động dò tìm trên macOS / Linux / Windows)
# Ví dụ macOS/Linux: ~/.local/bin/agy
# Ví dụ Windows: C:\Users\TenBan\.local\bin\agy.exe
AGY_PATH=

# 4. Thư mục gốc chứa các dự án (/projects, /cd TenDuAn) và Đại bản doanh Trợ lý cá nhân (/pa)
# Ví dụ macOS/Linux: ~/Projects và ~/Projects/Personal_Assistant
# Ví dụ Windows: C:\Users\TenBan\Projects và C:\Users\TenBan\Projects\Personal_Assistant
PROJECTS_ROOT=~/Projects
ASSISTANT_HOME=~/Projects/Personal_Assistant
DEFAULT_WORKSPACE=~/Projects/Personal_Assistant

# 5. Múi giờ cho tính năng nhắc việc & lịch trình định kỳ (chuẩn IANA, vd: Asia/Ho_Chi_Minh).
# Để trống để tự động nhận diện múi giờ hệ thống trên máy của bạn.
ASSISTANT_TIMEZONE=

# 6. Model mặc định (xem danh sách bằng lệnh /model trên Telegram). Để trống = mặc định của agy
DEFAULT_MODEL=

# 7. Chế độ duyệt quyền:
# - default      : Hỏi trước cả khi sửa file & khi chạy lệnh shell
# - accept-edits : Tự sửa file trong workspace, chỉ hỏi khi chạy lệnh shell (Khuyên dùng)
# - plan         : Lập kế hoạch trước khi thực thi
DEFAULT_MODE=accept-edits

# 8. Tự động duyệt mọi yêu cầu không cần hỏi (Khuyến nghị: false)
AUTO_APPROVE=false

# 9. Thời gian chờ bấm nút duyệt trên Telegram (giây), quá hạn sẽ tự động từ chối
APPROVAL_TIMEOUT_SECONDS=600
